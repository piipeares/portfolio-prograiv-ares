---
import { SITE } from '../data/profile';
---

<section id="contacto" class="section section--line contact">
  <div class="container">
    <div class="contact__top">
      <p class="eyebrow">05 / Contacto</p>
      <p class="contact__status">
        <span class="contact__status-dot" aria-hidden="true"></span>
        Disponible · Buenos Aires / Remoto (Worldwide)
      </p>
    </div>

    <h2 class="contact__title">¿Hablemos<span>?</span></h2>

    <div class="contact__grid">
      <p class="contact__lead">
        Si tenés una idea que necesita una interfaz, una imagen o un sistema que las conecte, escribime.
        También estoy abierto a colaboraciones académicas y proyectos experimentales.
      </p>

      <div class="contact__links">
        <a class="contact__mail" href={`mailto:${SITE.email}`}>
          <span>{SITE.email}</span>
          <span aria-hidden="true">↗</span>
        </a>
        <div class="contact__social">
          <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer">
            WhatsApp <span aria-hidden="true">↗</span>
          </a>
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="contact__phone">
          <span class="mono">{SITE.phone}</span> · Buenos Aires / Remoto (Worldwide)
        </p>
      </div>
    </div>

    <div class="contact__meta">
      <span>GMT-3</span>
      <span>Español / Inglés</span>
      <span>{SITE.university}</span>
      <span>4.º año en curso</span>
    </div>
  </div>
</section>

<style>
  .contact {
    overflow: hidden;
  }

  .contact__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }

  .contact__top .eyebrow {
    margin-bottom: 0;
  }

  .contact__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--mono);
    font-size: 0.54rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .contact__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fuchsia);
    box-shadow: 0 0 12px rgba(217, 70, 239, 0.85);
  }

  .contact__title {
    margin: 1.5rem 0 2rem;
    font-family: var(--display);
    font-size: clamp(2.6rem, 8vw, 6.5rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .contact__title span {
    color: var(--fuchsia);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.8fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .contact__lead {
    max-width: 54ch;
    margin: 0;
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    line-height: 1.6;
    color: #d4d4d8;
  }

  .contact__mail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--display);
    font-size: clamp(1.15rem, 2.4vw, 1.65rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--paper);
    transition: border-color 0.25s, color 0.25s;
  }

  .contact__mail span:last-child {
    color: var(--fuchsia-soft);
    transition: transform 0.25s var(--ease);
  }

  .contact__mail:hover {
    border-color: var(--fuchsia);
    color: var(--fuchsia-soft);
  }

  .contact__mail:hover span:last-child {
    transform: translate(2px, -2px);
  }

  .contact__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    margin-top: 1rem;
  }

  .contact__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 40px;
    font-family: var(--mono);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s;
  }

  .contact__social a:hover {
    color: var(--paper);
  }

  .contact__social a span {
    color: var(--fuchsia-soft);
  }

  .contact__phone {
    margin: 0.5rem 0 0;
    font-size: 0.74rem;
    color: var(--dim);
  }

  .contact__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-soft);
    font-family: var(--mono);
    font-size: 0.52rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  @media (max-width: 820px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }

    .contact__lead {
      max-width: 100%;
    }
  }

  @media (max-width: 520px) {
    .contact__top {
      align-items: flex-start;
      flex-direction: column;
    }

    .contact__title {
      font-size: clamp(1.6rem, 7.5vw, 4rem);
      text-transform: none;
      letter-spacing: -0.04em;
    }

    .contact__mail {
      font-size: 1rem;
    }

    .contact__meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
