---
import SignalScene from './react/SignalScene';
import SignalDial from './react/SignalDial';
import { SITE, PROJECTS } from '../data/profile';
---

<SignalScene client:only="react" />

<section id="inicio" class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">
        <span class="hero__eyebrow-dot" aria-hidden="true"></span>
        Portfolio · Programación Multimedial IV
      </p>

      <h1 class="hero__title" aria-label="Felipe Ares">
        <span aria-hidden="true">Felipe</span>
        <span class="hero__title-outline" aria-hidden="true">Ares</span>
      </h1>

      <p class="hero__role">{SITE.role}</p>

      <p class="hero__manifesto">
        Diseño y construyo experiencias donde la imagen, la interfaz y el código funcionan como un mismo
        sistema. Este portfolio no es un CV: es una experiencia que podés explorar.
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#obra">
          Explorar la obra <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href="#manifiesto">Leer el manifiesto</a>
      </div>

      <dl class="hero__facts">
        <div>
          <dt>Base</dt>
          <dd>Buenos Aires / Remoto</dd>
        </div>
        <div>
          <dt>Foco</dt>
          <dd>UX/UI + 3D</dd>
        </div>
        <div>
          <dt>Formación</dt>
          <dd>U. Maimónides</dd>
        </div>
      </dl>
    </div>

    <div class="hero__dial">
      <SignalDial client:load />
    </div>
  </div>

  <div class="container hero__foot">
    <a class="hero__scroll" href="#manifiesto">
      <span class="hero__scroll-line" aria-hidden="true"></span>
      Bajar al contenido
    </a>
    <p class="hero__foot-note">{PROJECTS.length} piezas · 3 canales · 1 portfolio</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding: clamp(7.5rem, 14vh, 11rem) 0 1.5rem;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(330px, 0.82fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .hero__copy {
    position: relative;
    min-width: 0;
    isolation: isolate;
  }

  .hero__copy::after {
    content: '';
    position: absolute;
    inset: -10% -12%;
    z-index: -1;
    background: radial-gradient(
      ellipse at 36% 46%,
      rgba(5, 5, 5, 0.84) 0%,
      rgba(5, 5, 5, 0.52) 52%,
      transparent 78%
    );
    pointer-events: none;
  }

  .hero__copy::before {
    content: '';
    position: absolute;
    top: 6%;
    left: -12%;
    z-index: -1;
    width: 64%;
    height: 52%;
    background: radial-gradient(ellipse, rgba(139, 92, 246, 0.16), transparent 70%);
    filter: blur(28px);
    pointer-events: none;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero__eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fuchsia);
    box-shadow: 0 0 12px rgba(217, 70, 239, 0.9);
    animation: pulse-dot 2.4s ease-in-out infinite;
  }

  .hero__title {
    margin: 1rem 0 0;
    font-family: var(--display);
    font-size: clamp(3.8rem, 8.6vw, 7.4rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.07em;
    text-transform: uppercase;
  }

  .hero__title span {
    display: block;
  }

  .hero__title-outline {
    color: transparent;
    -webkit-text-stroke: 2px rgba(244, 244, 245, 0.85);
    paint-order: stroke fill;
  }

  .hero__role {
    margin: 1.35rem 0 0;
    font-family: var(--mono);
    font-size: clamp(0.58rem, 1vw, 0.7rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fuchsia-soft);
  }

  .hero__manifesto {
    max-width: 54ch;
    margin: 0.9rem 0 0;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.55;
    color: #d4d4d8;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.75rem;
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    max-width: 580px;
    margin: 2.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .hero__facts dt {
    font-family: var(--mono);
    font-size: 0.5rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .hero__facts dd {
    margin: 0.25rem 0 0;
    font-size: 0.8rem;
    line-height: 1.35;
    color: #d4d4d8;
  }

  .hero__dial {
    min-width: 0;
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(2.5rem, 7vh, 5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--line-soft);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: 0.54rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero__scroll:hover {
    color: var(--paper);
  }

  .hero__scroll-line {
    position: relative;
    display: inline-block;
    width: 1px;
    height: 30px;
    overflow: hidden;
    background: var(--line);
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--fuchsia);
    animation: scroll-cue 2s var(--ease) infinite;
  }

  .hero__foot-note {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.52rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }

  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.8);
    }
  }

  @keyframes scroll-cue {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }

  @media (max-width: 980px) {
    .hero {
      min-height: auto;
      padding-top: 9rem;
    }

    .hero__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero__dial {
      max-width: 540px;
    }

    .hero__foot {
      margin-top: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 8.5rem;
    }

    .hero__title {
      font-size: clamp(3rem, 14vw, 4.6rem);
      line-height: 0.82;
      -webkit-text-stroke: 1.2px rgba(244, 244, 245, 0.85);
    }

    .hero__title-outline {
      -webkit-text-stroke: 1.2px rgba(244, 244, 245, 0.85);
    }

    .hero__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem;
    }

    .hero__actions .btn {
      width: 100%;
    }

    .hero__foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
